<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\LayerCake.Application\LayerCake.Application.csproj" />
  </ItemGroup>

  <!-- Slice 005: the typed HttpClient behind IPaymentGateway comes from
       Microsoft.Extensions.Http, which ships in the ASP.NET Core shared
       framework the WebApi already runs on. A framework reference, not a
       package, so nothing new to pin. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- Slice 004: the raw client behind IMessagePublisher. No framework on
         purpose; the hand-written publisher and consumer are the exhibit. -->
    <PackageReference Include="RabbitMQ.Client" />
  </ItemGroup>

</Project>
